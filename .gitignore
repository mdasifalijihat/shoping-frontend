# Dependencies and package manager caches
/node_modules/
/.pnpm-store/
/.pnp/
.pnp.*
.yarn/*
!.yarn/patches/
!.yarn/plugins/
!.yarn/releases/
!.yarn/versions/

# Next.js, TypeScript, and build output
/.next/
/out/
/build/
*.tsbuildinfo
/next-env.d.ts

# Test and lint output
/coverage/
/.eslintcache

# Environment files and private keys
.env*
!.env.example
*.pem

# Local deployment metadata
/.vercel/

# Package manager logs
npm-debug.log*
pnpm-debug.log*
.pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating system and local editor files
.DS_Store
Thumbs.db
Desktop.ini
/.history/
